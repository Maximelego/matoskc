# Public frontend values, injected at BUILD time. Rebuild to change them.
MATOSKC_DOMAIN=matoskc.hexenis.fr
VITE_PUBLIC_APP_URL=https://matoskc.hexenis.fr

# Directory with fullchain.pem and privkey.pem, from a trusted TLS authority.
MATOSKC_TLS_CERTS_DIR=./secrets/tls
MATOSKC_GARAGE_CONFIG=./secrets/garage.prod.toml

# Use new production credentials. Hexadecimal passwords avoid quoting issues.
MATOSKC_DB_PASSWORD=
# Generate the key as GK followed by 32 hexadecimal characters.
MATOSKC_S3_ACCESS_KEY=
MATOSKC_S3_SECRET_KEY=
MATOSKC_S3_BUCKET=matoskc

# Required on first deployment. Remove email/password after account creation.
MATOSKC_BOOTSTRAP_ADMIN_EMAIL=
MATOSKC_BOOTSTRAP_ADMIN_PASSWORD=
MATOSKC_BOOTSTRAP_ADMIN_NAME=Super administrateur
MATOSKC_SESSION_HOURS=8

# Change BOTH if this subnet overlaps an existing Docker network.
MATOSKC_NETWORK_SUBNET=172.30.83.0/24
MATOSKC_PROXY_IP=172.30.83.2
