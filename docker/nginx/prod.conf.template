server {
    listen 80;
    server_name ${MATOSKC_DOMAIN};
    return 308 https://${MATOSKC_DOMAIN}$request_uri;
}

server {
    listen 443 ssl;
    server_name ${MATOSKC_DOMAIN};
    server_tokens off;
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 25m;

    # Re-resolve service names after container recreation.
    resolver 127.0.0.11 valid=10s ipv6=off;

    location = /backend {
        return 308 /backend/$is_args$args;
    }

    location ^~ /backend/ {
        set $api_upstream backend:8000;
        rewrite ^/backend/(.*)$ /$1 break;
        proxy_pass http://$api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
    }

    location / {
        set $frontend_upstream frontend:80;
        proxy_pass http://$frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }
}
